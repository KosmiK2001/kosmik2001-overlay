+                break;
+        case GSM_LOGOUT_RESPONSE_SWITCH_USER:
+                request_switch_user (manager);
+                break;
+        default:
+                request_logout (manager, GSM_MANAGER_LOGOUT_MODE_NO_CONFIRMATION);
+                break;
+        }
+
+        return G_SOURCE_REMOVE;
