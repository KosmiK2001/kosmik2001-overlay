-        gchar *v;
-        gsize  len;
-
-        v = g_strstrip (g_strdup (value));
-        len = strlen (v);
-
-        if (len >= 2
-            && (v[0] == '"' || v[0] == '\'')
-            && v[len - 1] == v[0]) {
-                memmove (v, v + 1, len - 2);
-                v[len - 2] = '\0';
-        }
-
-        return v;
