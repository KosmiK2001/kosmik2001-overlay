diff --git a/wayfire/mate-wayland-session.in b/wayfire/mate-wayland-session.in
new file mode 100755
index 00000000..d4f90345
--- /dev/null
+++ b/wayfire/mate-wayland-session.in
@@ -0,0 +1,166 @@
+#!/bin/sh
+#
+# MATE Wayland session launcher.
+
+# Make sure we run as a Wayland session
+export XDG_SESSION_TYPE="wayland"
+export XDG_CURRENT_DESKTOP="MATE"
+
+# Make all toolkits prefer their Wayland backends (with safe fallbacks)
+if [ -z "${GDK_BACKEND}" ]; then
+  GDK_BACKEND="wayland,x11"
+  export GDK_BACKEND
+fi
+if [ -z "${QT_QPA_PLATFORM}" ]; then
+  QT_QPA_PLATFORM="wayland"
+  export QT_QPA_PLATFORM
+fi
+if [ -z "${CLUTTER_BACKEND}" ]; then
+  CLUTTER_BACKEND="gdk"
+  export CLUTTER_BACKEND
+fi
+export MOZ_ENABLE_WAYLAND="1"
+
+# Set XDG_RUNTIME_DIR for display managers that do not provide it.
+if [ -z "${XDG_RUNTIME_DIR}" ]; then
+  if [ -d "/run/user/$(id -ru)" ]; then
+    XDG_RUNTIME_DIR="/run/user/$(id -ru)"
+  elif [ -d "/var/run/user/$(id -ru)" ]; then
+    XDG_RUNTIME_DIR="/var/run/user/$(id -ru)"
+  else
+    XDG_RUNTIME_DIR="/tmp/${USER}-runtime"
+  fi
+  export XDG_RUNTIME_DIR
+fi
+if [ ! -d "${XDG_RUNTIME_DIR}" ]; then
+  mkdir -p -m 0700 "${XDG_RUNTIME_DIR}" || {
+    echo "$0: Unable to create runtime directory ${XDG_RUNTIME_DIR}!" >&2
+    exit 1
+  }
+fi
+
+CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"
+CONFIG_DIR="${CONFIG_HOME}/mate"
+CONFIG="${CONFIG_DIR}/wayfire.ini"
+
+create_initial_config()
+{
+  mkdir -p "${CONFIG_DIR}"
+
+  # Use the MATE Wayfire configuration shipped with this package. It is
+  # copied only once; afterwards the user is free to customize the copy at
+  # ~/.config/mate/wayfire.ini (the existence check below skips this on
+  # later logins).
+  cp "@MATE_WAYLAND_DATADIR@/wayfire.ini" "${CONFIG}" || {
+    echo "$0: Unable to install the default Wayfire configuration" >&2
+    return 1
+  }
+
+  # Make sure the file is writable so we can tune it below.
+  chmod u+w "${CONFIG}"
+
+  # Set the keyboard layout to match the system configuration, unless the
+  # user has already configured one.
+  if ! grep -q '^xkb_layout' "${CONFIG}"; then
+    KEYMAP=$(awk -F '=' -v q1=\' -v q2=\" '
+      $1 == "KEYMAP" {
+        gsub ("[" q1 q2 "]", "", $2)
+        keymap = $2
+      }
+      $1 == "XKBLAYOUT" {
+        gsub ("[" q1 q2 "]", "", $2)
+        layout = $2
+      }
+      $1 == "XKBVARIANT" {
+        gsub ("[" q1 q2 "]", "", $2)
+        variant = $2
+      }
+      END {
+        if (layout != "") {
+          print "layout=" layout
+          if (variant != "") {
+            print "variant=" variant
+          }
+        } else if (keymap != "") {
+          print "layout=" keymap
+        }
+      }
+    ' /etc/vconsole.conf)
+    if [ -n "${KEYMAP}" ]; then
+      LAYOUT=$(printf '%s\n' "${KEYMAP}" | sed -n 's/^layout=//p')
+      VARIANT=$(printf '%s\n' "${KEYMAP}" | sed -n 's/^variant=//p')
+      {
+        printf '\n[input]\n'
+        printf 'xkb_layout = %s\n' "${LAYOUT}"
+        if [ -n "${VARIANT}" ]; then
+          printf 'xkb_variant = %s\n' "${VARIANT}"
+        fi
+      } >> "${CONFIG}"
+    fi
+  fi
+
+  return 0
+}
+
+if [ ! -e "${CONFIG}" ]; then
+  create_initial_config || exit 1
+fi
+
+if ! command -v wayfire >/dev/null 2>&1; then
+  echo "$0: wayfire is not installed; aborting session" >&2
+  exit 1
+fi
+
+# Start the compositor
+wayfire -c "${CONFIG}" &
+WAYFIRE_PID=$!
+
+# Wait for the Wayland socket to appear
+WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
+export WAYLAND_DISPLAY
+SOCKET="${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}"
+i=0
+while [ ! -S "${SOCKET}" ] && [ "${i}" -lt 100 ]; do
+  i=$((i + 1))
+  sleep 0.1
+done
+
+if [ ! -S "${SOCKET}" ]; then
+  echo "$0: Wayfire failed to start; aborting session" >&2
+  kill "${WAYFIRE_PID}" 2>/dev/null
+  exit 1
+fi
+
+# Make bus-activated and systemd-managed services aware of the Wayland
+# environment (also fixes the slow startup of Gtk+3 applications).
+if command -v dbus-update-activation-environment >/dev/null 2>&1; then
+  dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XAUTHORITY 2>/dev/null
+fi
+
+# Run the session manager. The compositor is the leader here: wayfire's
+# [autostart] only fires commands that are not lifecycle-tracked, so
+# mate-session runs in the foreground and is responsible for components.
+mate-session "$@" &
+MATE_PID=$!
+
+# End the session if the compositor goes away (crash) while mate-session
+# is still running.
+(
+  while [ -S "${SOCKET}" ]; do
+    sleep 1
+  done
+  if kill -0 "${MATE_PID}" 2>/dev/null; then
+    kill "${MATE_PID}" 2>/dev/null
+  fi
+) &
+WATCHER_PID=$!
+
+wait "${MATE_PID}"
+status=$?
+
+# Session over (logout): terminate the compositor.
+kill "${WAYFIRE_PID}" 2>/dev/null
+kill "${WATCHER_PID}" 2>/dev/null
+wait "${WAYFIRE_PID}" 2>/dev/null
+
+exit ${status}
