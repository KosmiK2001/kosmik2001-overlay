@@ -124,11 +124,21 @@ is_disabled (GsmApp *app)
         }
 
         /* Check OnlyShowIn/NotShowIn/TryExec */
-        if (!egg_desktop_file_can_launch (priv->desktop_file, "MATE")) {
-                g_debug ("app %s not installed or not for MATE",
-                         gsm_app_peek_id (app));
-                return TRUE;
-        }
+	if (!egg_desktop_file_can_launch (priv->desktop_file, "MATE")) {
+		g_debug ("app %s not installed or not for MATE",
+			 gsm_app_peek_id (app));
+		return TRUE;
+	}
+
+        /* Check X-GNOME-HiddenUnderSystemd */
+	if (egg_desktop_file_get_boolean (priv->desktop_file,
+		                          "X-GNOME-HiddenUnderSystemd", NULL)
+            && gsm_util_session_is_wayland ()
+            && gsm_util_running_under_systemd_user ()) {
+		g_debug ("app %s is disabled by X-GNOME-HiddenUnderSystemd",
+			 gsm_app_peek_id (app));
+		return TRUE;
+	}
 
         /* Do not check AutostartCondition - this method is only to determine
          if the app is unconditionally disabled */
diff --git a/mate-session/gsm-util.c b/mate-session/gsm-util.c
index e091e807..ad32b99e 100644
--- a/mate-session/gsm-util.c
+++ b/mate-session/gsm-util.c
@@ -775,3 +775,22 @@ gsm_util_session_is_wayland (void)
 
 	return TRUE;
 }
+
+gboolean
+gsm_util_running_under_systemd_user (void)
+{
+	const gchar *runtime_dir;
+	gchar       *private_socket;
+	gboolean     running;
+
+	runtime_dir = g_getenv ("XDG_RUNTIME_DIR");
+	if (runtime_dir == NULL || runtime_dir[0] == '\0') {
+		return FALSE;
+	}
+
+	private_socket = g_build_filename (runtime_dir, "systemd", "private", NULL);
+	running = g_file_test (private_socket, G_FILE_TEST_EXISTS);
+	g_free (private_socket);
+
+	return running;
+}
