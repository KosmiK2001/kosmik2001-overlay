         watch->xalarm_negative = None;
@@ -373,6 +609,12 @@ idle_monitor_watch_free (GSIdleMonitorWatch *watch)
         if (watch == NULL) {
                 return;
         }
+#ifdef HAVE_WAYLAND
+        if (watch->notification != NULL) {
