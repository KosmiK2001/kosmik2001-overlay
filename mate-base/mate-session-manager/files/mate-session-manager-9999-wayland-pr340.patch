 G_DEFINE_TYPE (GSIdleMonitor, gs_idle_monitor, G_TYPE_OBJECT)
 
+static gboolean
+gs_idle_monitor_using_wayland (GSIdleMonitor *monitor)
+{
+        GdkDisplay *display;
+
+        display = gdk_display_get_default ();
+
+        if (display == NULL) {
+                return FALSE;
+        }
+
+        return ! GDK_IS_X11_DISPLAY (display);
+}
