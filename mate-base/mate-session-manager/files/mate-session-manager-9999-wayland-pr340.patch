+static gboolean
+confirm_dialog_timeout (GtkWidget *dialog)
+{
+        GsmManager *manager;
+        guint       timeout_id;
+        gint        response;
+
+        manager = g_object_get_data (G_OBJECT (dialog), "gsm-dialog-manager");
+        if (manager == NULL || ! GSM_IS_MANAGER (manager)) {
