+                monitor->wl_source_id = 0;
+        }
+
+        if (monitor->wl_display != NULL) {
+                wl_display_disconnect (monitor->wl_display);
+                monitor->wl_display = NULL;
+                monitor->wl_notifier = NULL;
+                monitor->wl_seat = NULL;
