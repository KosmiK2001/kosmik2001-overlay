@@ -99,6 +99,11 @@ msm_compat_gnome_smproxy_startup (void)
   GdkDisplay *gdkdisplay;
 
   gdkdisplay = gdk_display_get_default ();
+  /* smproxy is an X11-only compatibility hack: GNOME_SM_PROXY is a property on
