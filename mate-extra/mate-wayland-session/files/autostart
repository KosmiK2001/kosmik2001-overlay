#!/bin/sh
# Автозапуск сессии MATE на Wayland.
#
# Компоненты поднимает mate-session, а не этот скрипт. Причина не в удобстве:
# mate-session берёт на шине имя org.gnome.SessionManager, и именно его метод
# Logout вызывает кнопка «Выход» в панели (mate-panel/libpanel-util/
# panel-session-manager.c). Без менеджера сеанса завершение сеанса не работает
# вообще, а mate-settings-daemon и polkit-агент не могут зарегистрироваться как
# клиенты сеанса. Автозапуск приложений mate-session тоже берёт на себя —
# /etc/xdg/autostart (mate-settings-daemon, mate-notification-daemon,
# polkit-mate-authentication-agent-1 и прочее), плюс обязательные компоненты
# panel='mate-panel' и filemanager='caja'.
#
# Оконного менеджера в Wayland-сессии нет — WM это композитор. Заглушка нужна,
# чтобы mate-wm не полез искать в PATH marco: тот попытается захватить WM-выбор
# в XWayland, который уже держит labwc, и упадёт.
export WINDOW_MANAGER=/usr/bin/mate-wayland-wm-stub

mate-session

# mate-session завершился (logout или shutdown) — гасим композитор, чтобы
# вернуться в greeter sddm. Без этого остаётся пустой экран с живым labwc.
labwc --exit
