#!/usr/bin/env python3
"""Minimal org.mate.SessionManager provider for the MATE Wayland session.

mate-wayland-session does not run mate-session (gsm), so nothing owns
org.gnome.SessionManager on the session bus.  The panel's "Log out" action is a
D-Bus call to that name (panel_session_manager_request_logout()), so it fails
with ServiceUnknown and no dialog appears.

This service implements just enough of the interface for the panel: Logout,
Shutdown, Reboot, CanShutdown, IsInhibited and the SessionName property.  The
actual session exit is delegated to wayland-logout, which terminates the
compositor; the display manager then brings the greeter back.

Deliberately no dialog: the panel already shows its own confirmation.
"""

import os
import signal
import subprocess
import sys

import gi

gi.require_version("Gio", "2.0")
gi.require_version("GLib", "2.0")
gi.require_version("Gtk", "3.0")
from gi.repository import Gio, GLib, Gtk

BUS_NAME = "org.gnome.SessionManager"
OBJECT_PATH = "/org/gnome/SessionManager"

INTROSPECTION = """
<node>
  <interface name="org.gnome.SessionManager">
    <method name="Logout">
      <arg name="mode" type="u" direction="in"/>
    </method>
    <method name="Shutdown"/>
    <method name="Reboot"/>
    <method name="CanShutdown">
      <arg name="can_shutdown" type="b" direction="out"/>
    </method>
    <method name="IsInhibited">
      <arg name="is_inhibited" type="b" direction="out"/>
    </method>
    <property name="SessionName" type="s" access="read"/>
  </interface>
</node>
"""


def log(message):
    sys.stderr.write("mate-wayland-session-manager: %s\n" % message)
    sys.stderr.flush()


def ask_confirmation(on_accept):
    """Show the logout confirmation the panel expects from a session manager."""
    dialog = Gtk.MessageDialog(
        message_type=Gtk.MessageType.QUESTION,
        buttons=Gtk.ButtonsType.NONE,
        text="Завершить сеанс?",
    )
    dialog.format_secondary_text(
        "Все приложения будут закрыты. Несохранённые данные могут быть потеряны."
    )
    dialog.add_button("Отмена", Gtk.ResponseType.CANCEL)
    dialog.add_button("Завершить сеанс", Gtk.ResponseType.OK)
    dialog.set_default_response(Gtk.ResponseType.CANCEL)
    dialog.set_keep_above(True)

    def on_response(dlg, response_id):
        dlg.destroy()
        if response_id == Gtk.ResponseType.OK:
            on_accept()

    dialog.connect("response", on_response)
    dialog.show_all()


def quit_session(reason):
    """Terminate the compositor; the display manager takes over from there."""
    log("session exit requested (%s)" % reason)

    def _later():
        # wayland-logout kills the compositor it finds in WAYLAND_DISPLAY.
        try:
            subprocess.Popen(["wayland-logout"])
        except OSError as exc:
            log("cannot run wayland-logout: %s" % exc)
            # Last resort: take the compositor down ourselves.
            parent = os.getppid()
            try:
                os.kill(parent, signal.SIGTERM)
            except OSError as exc2:
                log("cannot signal parent: %s" % exc2)
        return False

    # Let the D-Bus reply go out before the bus disappears.
    GLib.timeout_add(200, _later)


class SessionManager:
    def __init__(self):
        self.connection = None
        self.registration_id = 0

    def on_bus_acquired(self, connection, name):
        self.connection = connection
        node = Gio.DBusNodeInfo.new_for_xml(INTROSPECTION)
        self.registration_id = connection.register_object(
            OBJECT_PATH,
            node.interfaces[0],
            self.handle_method_call,
            self.handle_get_property,
            None,
        )
        log("owning %s at %s" % (BUS_NAME, OBJECT_PATH))

    def handle_method_call(self, connection, sender, object_path, interface_name,
                           method_name, parameters, invocation):
        if method_name == "Logout":
            (mode,) = parameters.unpack()
            invocation.return_value(None)
            # 0 = NORMAL (ask first), 1 = NO_CONFIRMATION, 2 = FORCE.
            if mode == 0:
                ask_confirmation(lambda: quit_session("Logout(%u) from %s" % (mode, sender)))
            else:
                quit_session("Logout(%u) from %s" % (mode, sender))
        elif method_name in ("Shutdown", "Reboot"):
            quit_session(method_name)
            invocation.return_value(None)
        elif method_name == "CanShutdown":
            invocation.return_value(GLib.Variant("(b)", (True,)))
        elif method_name == "IsInhibited":
            invocation.return_value(GLib.Variant("(b)", (False,)))
        else:
            invocation.return_dbus_error(
                "org.freedesktop.DBus.Error.UnknownMethod",
                "Unknown method %s" % method_name,
            )

    def handle_get_property(self, connection, sender, object_path,
                            interface_name, property_name):
        if property_name == "SessionName":
            return GLib.Variant("s", os.environ.get("DESKTOP_SESSION", "MATE"))
        return None


def main():
    Gtk.init([])
    manager = SessionManager()
    Gio.bus_own_name(
        Gio.BusType.SESSION,
        BUS_NAME,
        Gio.BusNameOwnerFlags.NONE,
        manager.on_bus_acquired,
        None,
        lambda connection, name: log("lost the bus name %s" % name),
    )
    GLib.MainLoop().run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
