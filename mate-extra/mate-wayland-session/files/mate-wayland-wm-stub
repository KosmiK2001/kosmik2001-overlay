#!/bin/sh
# Заглушка «оконного менеджера» для Wayland-сессии MATE.
#
# mate-session всегда запускает WM через data/mate-wm, а под Wayland WM — это
# сам композитор. Без заглушки mate-wm находит в PATH marco, тот пытается
# захватить WM-выбор в XWayland (его уже держит labwc) и падает, а mate-session
# показывает «оконный менеджер упал».
#
# Заглушка просто висит, пока жива сессия: mate-session считает WM запущенным.
# Аргументы (--sm-client-id=... и т.п.) игнорируются.

while :; do
	sleep 3600
done
